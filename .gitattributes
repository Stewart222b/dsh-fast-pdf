# Normalise line endings: LF in the repository, LF on checkout.
# Without this Windows checks files out as CRLF and every commit shows
# the whole file as changed.
* text=auto eol=lf

*.ps1 text eol=crlf

# Bytes, never diffed, never converted
*.pdf binary
*.png binary
*.wasm binary
*.ttf binary
*.bcmap binary
